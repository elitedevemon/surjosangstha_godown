# ============================================================
#  SurjoSangstha — Environment Variables (প্রোডাকশন টেমপ্লেট)
#  হোস্টিং ড্যাশবোর্ডে এই ভ্যারিয়েবলগুলো যোগ করুন
# ============================================================

# ---------- ডাটাবেস (যেকোনো একটি পদ্ধতি) ----------
# পদ্ধতি ১ — এক লাইনে:
DATABASE_URL=mysql://user:password@host:3306/dbname?ssl=true

# পদ্ধতি ২ — আলাদা আলাদা (DATABASE_URL না দিলে এগুলো ব্যবহার হবে):
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=3306
# DB_USER=avnadmin
# DB_PASSWORD=your-password
# DB_NAME=defaultdb
# DB_SSL=true

# ---------- সিকিউরিটি (বাধ্যতামূলক) ----------
# openssl rand -base64 32   দিয়ে তৈরি করুন
AUTH_SECRET=change-this-to-a-long-random-string
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=change-this-strong-password

# ---------- ডেমো ডাটা ----------
# প্রোডাকশনে false রাখুন (ডেমো ডাটা অটো মুছে যাবে)
DEMO_DATA=false
# প্রথমবার টেবিল/এডমিন তৈরি করতে একবার true দিন, পরে সরিয়ে ফেলুন
AUTO_SEED=false

# ---------- HTTPS কুকি ----------
COOKIE_SECURE=true

# ---------- Pusher (ঐচ্ছিক — রিয়েল-টাইম) ----------
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=ap2
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ---------- Web Push (ঐচ্ছিক — মোবাইল/PC নোটিফিকেশন) ----------
# npx web-push generate-vapid-keys  দিয়ে তৈরি করুন
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# ---------- OpenRouter AI (ঐচ্ছিক — হেল্পডেস্ক সহকারী) ----------
# openrouter.ai → Keys থেকে নিন। না দিলে AI বন্ধ থাকবে, বাকি সব চলবে।
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=openrouter/free
# SITE_URL=https://yourdomain.com
