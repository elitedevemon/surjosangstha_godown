    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.10",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.39.0",
    "mysql2": "^3.24.3",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
